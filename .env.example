# loops environment variables.
#
# The HLP SDK itself reads no environment variables; configuration is passed
# explicitly in code. The variables below only affect the opt-in external CLI
# end-to-end tests under tests/external/ (skipped by default).

# Set to "1" to run tests/external/ against real CLI binaries on PATH
# (Codex / Kimi / Claude Code). Default: unset (tests are skipped).
HLP_RUN_EXTERNAL_CLI_E2E=

# Timeout in seconds for the soft-harness live E2E test. Default: 120.
HLP_SOFT_E2E_TIMEOUT=

# Where the soft-harness live E2E test writes its raw JSON result.
# Default: hlp-soft-live-e2e-result.json
HLP_SOFT_E2E_RESULT_PATH=
